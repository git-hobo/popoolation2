# Use Apptainer for ALL rules
import os
IMG = os.environ.get("IMG", "")
configfile: "config.yaml"

# Use Apptainer container for ALL rules
container: f"{IMG}/popoolation2.sif"


# ---------------------------------------------------------------------------
# Global config & naming
# ---------------------------------------------------------------------------

REF = config["reference"]
POPS = config["populations"]

FASTQ_DIR = config.get("fastq_dir", "samples")


# Tag based on all population names, e.g. "pop1_pop2" or "FR1_FR2_FR3"
POP_TAG  = "_".join(POPS)

MPILEUP  = f"results/{POP_TAG}.mpileup"
SYNC     = f"results/{POP_TAG}.sync"
SYNC_J   = f"results/{POP_TAG}_java.sync"
RC       = f"results/{POP_TAG}_rc"
PWC      = f"results/{POP_TAG}_pwc"
FST1     = f"results/{POP_TAG}.fst"
FST500   = f"results/{POP_TAG}_w500.fst"
FET      = f"results/{POP_TAG}.fet"
IGV      = f"results/{POP_TAG}.igv"


JAVA_SYNC_JAR = "/opt/popoolation2/mpileup2sync.jar" 
JAVA_SYNC_HEAP_GB = config.get("java_sync_heap_gb", 20)
JAVA_SYNC_THREADS = min(config.get("bwa_threads", 8), 16)
JAVA_SYNC_MEM_MB = config.get("java_sync_mem_mb", JAVA_SYNC_HEAP_GB * 1300)

# ---------------------------------------------------------------------------
# Rule: all
# ---------------------------------------------------------------------------

rule all:
    input:
        SYNC_J,
        PWC,
        FST1,
        FST500,
        FET,
        IGV,
        # trimmed reads for all populations
        expand("trimmed/{sample}_1_paired.fq.gz",   sample=POPS),
        expand("trimmed/{sample}_2_paired.fq.gz",   sample=POPS),
        expand("trimmed/{sample}_1_unpaired.fq.gz", sample=POPS),
        expand("trimmed/{sample}_2_unpaired.fq.gz", sample=POPS),
        # mapped & indexed BAMs (from trimmed PE reads)
        expand("map/{sample}.bam.bai", sample=POPS)

# ---------------------------------------------------------------------------
# Trimmomatic PE trimming (from raw R1+R2 to trimmed PE+SE)
# ---------------------------------------------------------------------------

rule trimmomatic_pe:
    """
    Trim adapters & low-quality bases using Trimmomatic (paired-end).
    Uses TruSeq3-PE adapters from Debian's trimmomatic package by default.
    """
    input:
        r1 = lambda wc: f"{FASTQ_DIR}/{wc.sample}_1.fq.gz",
        r2 = lambda wc: f"{FASTQ_DIR}/{wc.sample}_2.fq.gz"
    output:
        r1_paired   = "trimmed/{sample}_1_paired.fq.gz",
        r1_unpaired = "trimmed/{sample}_1_unpaired.fq.gz",
        r2_paired   = "trimmed/{sample}_2_paired.fq.gz",
        r2_unpaired = "trimmed/{sample}_2_unpaired.fq.gz"
    threads: config.get("bwa_threads", 8)
    params:
        adapters = "/usr/share/trimmomatic/TruSeq3-PE.fa",
        extra    = "LEADING:3 TRAILING:3 SLIDINGWINDOW:4:15 MINLEN:36"
    shell:
        r"""
        mkdir -p trimmed
        TrimmomaticPE \
            -threads {threads} \
            {input.r1} {input.r2} \
            {output.r1_paired} {output.r1_unpaired} \
            {output.r2_paired} {output.r2_unpaired} \
            ILLUMINACLIP:{params.adapters}:2:30:10 \
            {params.extra}
        """

# ---------------------------------------------------------------------------
# Index reference for bwa mem
# ---------------------------------------------------------------------------

rule bwa_index:
    input:
        REF
    output:
        REF + ".bwt"
    shell:
        "bwa index {input}"

# ---------------------------------------------------------------------------
# Paired-end mapping with bwa mem + sort/index BAM
# ---------------------------------------------------------------------------

rule bwa_mem_pe:
    """
    Map trimmed paired-end reads with bwa mem, then sort & index BAM.
    """
    input:
        ref = REF,
        idx = REF + ".bwt",
        r1  = lambda wc: f"trimmed/{wc.sample}_1_paired.fq.gz",
        r2  = lambda wc: f"trimmed/{wc.sample}_2_paired.fq.gz"
    output:
        bam = "map/{sample}.bam",
        bai = "map/{sample}.bam.bai"
    threads: config.get("bwa_threads", 8)
    params:
        mem_params = config.get("bwa_mem_params", "")
    shell:
        r"""
        mkdir -p map
        bwa mem {params.mem_params} -t {threads} {input.ref} {input.r1} {input.r2} \
          | samtools sort -o {output.bam} -
        samtools index {output.bam}
        """

# ---------------------------------------------------------------------------
# Create mpileup from all populations
# ---------------------------------------------------------------------------

rule mpileup:
    input:
        bams = expand("map/{sample}.bam", sample=POPS)
    output:
        MPILEUP
    shell:
        """
        mkdir -p results
        samtools mpileup -B {input.bams} > {output}
        """

# ---------------------------------------------------------------------------
# Create synchronized file (Perl version)
# ---------------------------------------------------------------------------

rule perl_mpileup2sync:
    input:
        MPILEUP
    output:
        SYNC
    params:
        minqual = config.get("mpileup_min_qual", 20)
    shell:
        """
        mpileup2sync.pl \
            --fastq-type sanger \
            --min-qual {params.minqual} \
            --input {input} \
            --output {output}
        """

# ---------------------------------------------------------------------------
# Create synchronized file (Java version – faster)
# ---------------------------------------------------------------------------

rule java_mpileup2sync:
    """
    Convert mpileup to synchronized file using the Java mpileup2sync.jar.
    Uses SYNC_J as the canonical sync file.
    """
    input:
        MPILEUP
    output:
        SYNC_J
    threads:
        JAVA_SYNC_THREADS
    params:
        minqual = config.get("mpileup_min_qual", 20),
        jar     = JAVA_SYNC_JAR,
        heap_gb = JAVA_SYNC_HEAP_GB
    resources:
        mem_mb = JAVA_SYNC_MEM_MB
    log:
        f"logs/java_mpileup2sync_{POP_TAG}.log"
    shell:
        r"""
        set -euxo pipefail
        echo "DEBUG: PWD inside container is: $PWD"
        echo "DEBUG: contents of results/"
        ls -l results || echo "results/ does not exist"
        mkdir -p logs
        java -ea -Xmx{params.heap_gb}g -jar {params.jar} \
            --input $PWD/{input} \
            --output $PWD/{output} \
            --fastq-type sanger \
            --min-qual {params.minqual} \
            --threads {threads} \
        &> {log}
        """

# ---------------------------------------------------------------------------
# Allele frequency differences (snp-frequency-diff.pl)
# ---------------------------------------------------------------------------

rule snp_frequency_diff:
    input:
        SYNC_J
    output:
        rc  = RC,
        pwc = PWC
    params:
        min_count = config.get("min_count", 6),
        min_cov   = config.get("min_cov", 50),
        max_cov   = config.get("max_cov", 200),
        prefix    = f"results/{POP_TAG}"
    shell:
        """
        snp-frequency-diff.pl \
            --input {input} \
            --output-prefix {params.prefix} \
            --min-count {params.min_count} \
            --min-coverage {params.min_cov} \
            --max-coverage {params.max_cov}
        """

# ---------------------------------------------------------------------------
# Fst per SNP (window size 1)
# ---------------------------------------------------------------------------

rule fst_snpwise:
    input:
        SYNC_J
    output:
        FST1
    params:
        min_count = config.get("min_count", 3),
        min_cov   = config.get("min_cov", 40),
        max_cov   = config.get("max_cov", 200),
        pool      = config.get("pool_size", 500)
    shell:
        """
        fst-sliding.pl \
            --input {input} \
            --output {output} \
            --suppress-noninformative \
            --min-count {params.min_count} \
            --min-coverage {params.min_cov} \
            --max-coverage {params.max_cov} \
            --min-covered-fraction 1 \
            --window-size 1 \
            --step-size 1 \
            --pool-size {params.pool}
        """

# ---------------------------------------------------------------------------
# Fst sliding windows (e.g. 500 bp)
# ---------------------------------------------------------------------------

rule fst_windows:
    input:
        SYNC_J
    output:
        FST500
    params:
        min_count = config.get("min_count", 3),
        min_cov   = config.get("min_cov", 40),
        max_cov   = config.get("max_cov", 200),
        pool      = config.get("pool_size", 500),
        win       = 500,
        step      = 500
    shell:
        """
        fst-sliding.pl \
            --input {input} \
            --output {output} \
            --min-count {params.min_count} \
            --min-coverage {params.min_cov} \
            --max-coverage {params.max_cov} \
            --min-covered-fraction 1 \
            --window-size {params.win} \
            --step-size {params.step} \
            --pool-size {params.pool}
        """

# ---------------------------------------------------------------------------
# Fisher's exact test (fisher-test.pl)
# ---------------------------------------------------------------------------

rule fisher_test:
    input:
        SYNC_J
    output:
        FET
    params:
        min_count = config.get("min_count", 3),
        min_cov   = config.get("min_cov", 40),
        max_cov   = config.get("max_cov", 200)
    shell:
        """
        fisher-test.pl \
            --input {input} \
            --output {output} \
            --min-count {params.min_count} \
            --min-coverage {params.min_cov} \
            --max-coverage {params.max_cov} \
            --suppress-noninformative
        """

# ---------------------------------------------------------------------------
# Convert Fst to IGV format (pwc2igv.pl)
# ---------------------------------------------------------------------------

rule pwc2igv:
    input:
        FST1
    output:
        IGV
    shell:
        """
        pwc2igv.pl \
            --input {input} \
            --output {output}
        """